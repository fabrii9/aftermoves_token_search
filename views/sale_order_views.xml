<odoo>

    <!-- Agregar campo token_search a la vista de búsqueda de sale.order -->
    <record id="sale_order_search_token_search" model="ir.ui.view">
        <field name="name">sale.order.search.token.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">

            <!-- Agregar el campo token_search al principio de la búsqueda -->
            <xpath expr="//search/field[@name='name']" position="before">
                <field
                    name="token_search"
                    string="Búsqueda Inteligente (tokens)"
                    filter_domain="[('token_search', 'ilike', self)]"
                />
            </xpath>

        </field>
    </record>

</odoo>
